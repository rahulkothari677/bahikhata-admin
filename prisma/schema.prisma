model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String    // hashed with bcrypt
  role          String    @default("viewer") // founder | finance | analyst | support | viewer
  totpSecret    String?   // TOTP 2FA secret (encrypted at rest)
  totpEnabled   Boolean   @default(false)
  isActive      Boolean   @default(true)

  // 🔒 SESSION REVOCATION (audit 2026-07-26). Stamped into the admin JWT at
  // login and re-checked against this column on every request by withAdmin().
  // Bump it to invalidate every existing session for this operator: on role
  // change, deactivation, password reset, 2FA disable and delete.
  //
  // Without this, `role` lived only in a 1-hour JWT and was never re-read, so
  // demoting or deactivating an admin left them with their old powers until the
  // token happened to expire. The main app already solved this for shopkeepers
  // via User.tokenVersion; it was simply never applied to admins themselves.
  tokenVersion  Int       @default(0)

  // 🔒 STEP-UP AUTHENTICATION (audit 2026-07-27).
  //
  // ROUTE_POLICY marks 11 routes `stepUp: true` — impersonation, exports, the
  // SQL console, admin-user management, bulk operations. Until now that flag
  // was documentation: nothing read it.
  //
  // A session lasts an hour. An unlocked laptop, a stolen cookie, or an
  // operator walking away is enough to reach every one of those routes. Being
  // logged in should not be the same as being present.
  //
  // Set when the operator re-enters a TOTP code; the routes above require it
  // to be recent (STEP_UP_WINDOW_MS). It is deliberately NOT a second session:
  // it expires in minutes, not hours.
  stepUpVerifiedAt DateTime?
  lastLoginAt   DateTime?
  lastLoginIp   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 🔒 V26 A1 FIX: Dedicated password-reset fields (was: no reset token
  // storage — the PATCH endpoint accepted ANY token without validation).
  passwordResetTokenHash String?  // SHA-256 hash of the reset token
  passwordResetExpiresAt DateTime? // 15-minute expiry

  adminActions  AdminAction[]

  @@index([email])
  @@index([isActive])
}
model AdminAction {
  id            String   @id @default(cuid())
  adminId       String
  // 🔒 onDelete: Cascade is deliberate but must NEVER fire in practice — the
  // admin-role.sql grants revoke DELETE on AdminUser, so an admin cannot be
  // deleted and take their audit trail with them. Deactivate instead.
  admin         AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action        String   // user_plan_change | user_ban | feature_toggle | data_export | etc.
  targetType    String?  // user | feature_flag | subscription | etc.
  targetId      String?  // ID of the affected entity
  description   String   // human-readable description
  metadata      Json?    // before/after values, etc.
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  // ═══════════════════════════════════════════════════════════════════════
  // 🔒 TAMPER-EVIDENT CHAIN (audit 2026-07-27).
  //
  // Each entry hashes its own contents TOGETHER WITH the previous entry's
  // hash, so the log is a chain. Editing or deleting any historical row breaks
  // every hash after it, and the break is detectable.
  //
  // Without this, the audit log is just a table. An admin with database access
  // — which every admin implicitly has via the SQL console — could edit the
  // record of what they did, and nothing would show it. An audit trail that
  // the audited party can silently rewrite provides no assurance at all, which
  // matters directly for DPDP Rule 6 and CERT-In log-retention obligations.
  //
  // This is DETECTION, not prevention. Prevention is the append-only GRANT in
  // prisma/grants/admin-role.sql (INSERT + SELECT, no UPDATE/DELETE). The two
  // are complementary: the grant stops the edit, the chain proves none happened.
  //
  // seq is a monotonic counter giving the chain a deterministic order —
  // createdAt can collide at millisecond resolution under concurrent writes.
  // ═══════════════════════════════════════════════════════════════════════
  seq           BigInt   @default(autoincrement())
  prevHash      String?  @db.VarChar(64) // null only for the very first entry
  hash          String?  @db.VarChar(64) // sha256(seq|adminId|action|...|prevHash)

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([seq])
}
