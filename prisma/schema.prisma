model DailyStats {
  // 🔒 2026-08-05: these money columns are Int, not Float. The shared database
  // stores money as integer PAISE — the main app's migration
  // 20260712000001_paise_migration ran ALTER COLUMN ... TYPE INTEGER on them.
  // This schema was never updated to match, so Prisma serialised a float8 into
  // an int4 column and every WRITE failed with Postgres 22P03 "incorrect binary
  // data format in bind parameter". Reads survived; writes did not.
  //
  // Found only after the missing DELETE grant was fixed: revenue recompute got
  // as far as its INSERT for the first time and hit this immediately.
  id   String   @id @default(cuid())
