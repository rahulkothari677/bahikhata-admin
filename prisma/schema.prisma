  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([action, status])
}

model NpsSurveyConfig {
  id           String @id @default(cuid())
  name         String
  triggerType  String // days_after_signup | transaction_count | days_since_last_survey | plan_upgrade | manual
  triggerValue Int // X (days, count, etc.)
  question     String @default("How likely are you to recommend BahiKhata Pro to a friend or colleague?")

  // Cooldown: don't show again for X days after user responds
  cooldownDays Int @default(90)

  // Targeting
  targetPlans String @default("all") // all | free | pro | elite (comma-separated)

  // Status
  enabled  Boolean @default(true)
  priority Int     @default(1) // higher = shown first if multiple match

  // Stats (updated when survey is shown)
  timesShown     Int @default(0)
  timesResponded Int @default(0)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, triggerType])
}

model DataExportRequest {
  id            String    @id @default(cuid())
  type          String // user_data | all_users | transactions | subscriptions | ai_usage | custom
  format        String    @default("csv") // csv | json
  status        String    @default("pending") // pending | processing | completed | failed
  userId        String? // for user_data type (which user's data)
  customQuery   String?   @db.Text // for custom type (SQL query)
  fileName      String? // generated file name
  fileSizeBytes Int       @default(0)
  rowCount      Int       @default(0)
  errorMessage  String?   @db.Text
  requestedBy   String? // admin who requested
  processedBy   String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  expiresAt     DateTime? // download link expiry (default 24h)

  @@index([status, createdAt])
  @@index([type, status])
}

model ChurnPrediction {
  id        String  @id @default(cuid())
  userId    String  @unique
  userName  String?
  userEmail String?
  userPlan  String?

  // Risk score (0-100, higher = more likely to churn)
  riskScore Int
  riskLevel String // low | medium | high | critical

  // Individual factor scores (0-100 each)
  inactivityScore Int @default(0) // days since last login
  engagementScore Int @default(0) // days since last transaction
  aiUsageScore    Int @default(0) // AI usage decline
  planScore       Int @default(0) // plan tier factor
  ageScore        Int @default(0) // account age factor
  supportScore    Int @default(0) // support ticket factor

  // Recommendation
  recommendedAction String? // e.g. "Send win-back campaign", "Offer discount"

  // Metadata
  computedAt DateTime @default(now())

  @@index([riskLevel, riskScore])
  @@index([userPlan, riskLevel])
