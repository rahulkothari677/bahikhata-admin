model InvoiceCounter {
  userId        String @id
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  seq           Int    @default(0)
  // V17-Ext Tier 3: Separate counters for credit/debit notes
  creditNoteSeq Int    @default(0)
  debitNoteSeq  Int    @default(0)
  // 🔒 V26 Phase 8 DI-1: Separate counter for purchases (was: shared with
  // sales seq → purchases numbered INV-XXXX, eating gaps in the sales series).
  purchaseSeq   Int    @default(0)
}

model Document {
  id                 String    @id @default(cuid())
  userId             String // owner of this document
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopId             String? // multi-shop: null = all shops
  name               String // user-provided filename or description
  category           String    @default("other") // bill | invoice | gst-certificate | bank-statement | id-proof | other
  fileType           String // mime type: image/jpeg, application/pdf, etc.
  fileSize           Int       @default(0) // in bytes
  // Cloudinary storage
  cloudinaryUrl      String // secure_url from Cloudinary
  cloudinaryPublicId String // public_id for deletion
  // Optional metadata
  notes              String?
  tags               String[]  @default([]) // free-form tags for search
  uploadedAt         DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // Soft delete for audit trail
  deletedAt          DateTime?

  @@index([userId, deletedAt])
  @@index([userId, category])
  @@index([userId, uploadedAt])
}

model ImpersonationToken {
  id           String    @id @default(cuid())
  // SHA-256 hash of the raw 32-byte token. The raw token is NEVER stored —
  // only the hash. Lookup is by tokenHash (unique).
  tokenHash    String    @unique
  // The admin who created this token (AdminUser.id from the admin app).
  // Stored as a plain string (no FK) because AdminUser lives in the admin
  // app's auth domain — the main app doesn't query AdminUser directly.
  adminId      String
  // Denormalized admin email for audit display (so the main app can show
  // "Impersonating as {adminEmail}" without a cross-DB join).
  adminEmail   String
  // The shopkeeper being impersonated (User.id). The main app's consumer
  // endpoint creates a NextAuth session bound to this userId.
  targetUserId String
  // 5-minute expiry. The admin app sets this when creating the token; the
  // main app checks expiresAt > now() on redemption.
  expiresAt    DateTime
  // Single-use enforcement. NULL = unused (valid for redemption).
  // Non-NULL = already redeemed (token can't be replayed).
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([targetUserId])
  @@index([adminId])
  @@index([expiresAt])
}

// 🐛 FIX (integration-phase-D.1): REMOVED `FeatureFlagRule` model.
//
// This model was defined in the admin schema but:
//   1. NEVER queried by any route in either app (verified via grep)
//   2. NOT present in the main app's schema (main app owns all migrations)
//   3. NO migration ever created the table in the DB
//
// It was a ticking data-loss bomb: if the main app ever ran `prisma db push`
// (e.g., during a hotfix), Prisma would have dropped the table. Since the
// table never existed in the DB and the model was dead code, removing it
// from the admin schema is safe and resolves the schema-drift risk.
//
// If advanced feature-flag targeting is needed in the future, it should be
// designed properly: add the model to BOTH schemas simultaneously, with the
// main app owning the migration. See INTEGRATION-CONTRACT.md (Phase D.6).

/// Per-user, per-channel, per-category messaging consent.
///
/// 🔒 DPDP + TRAI (audit 2026-07-28, §B6). The ABSENCE of a row means no
/// promotional consent: silence is not opt-in. Transactional and service
/// messages do not consult this table at all — a receipt is not marketing.
model CommunicationPreference {
  id         String    @id @default(cuid())
  userId     String
  channel    String // sms | email | push | whatsapp
  category   String // promotional (transactional/service are never gated)
  optedIn    Boolean   @default(false)
  /// Where the opt-in came from — required to evidence double opt-in.
  source     String?
  optedInAt  DateTime?
  optedOutAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, channel, category])
  @@index([userId])
}

/// Time-boxed emergency access (master report §C4).
///
/// Exists precisely BECAUSE the normal controls are strict. Designed so that
/// using it is safe but impossible to hide: every session has a written
/// reason, a hard expiry, and a critical audit entry. There is no way to
/// activate one quietly.
model BreakGlassSession {
  id         String    @id @default(cuid())
  adminId    String
  adminEmail String
  /// Free text, mandatory. A break-glass with no stated reason is
  /// indistinguishable from an intruder, months later when someone asks.
  reason     String    @db.Text
  /// Null when a single founder self-approved. Recorded either way so the
  /// unapproved ones are countable rather than invisible — the "I am the only
  /// founder at 3am" case is legitimate and must still be reviewable.
  approvedBy String?
  startedAt  DateTime  @default(now())
  /// Hard ceiling of 60 minutes, enforced in code at activation.
  expiresAt  DateTime
  /// Set when ended early. Expiry is by time; this is by choice.
  revokedAt  DateTime?
  revokedBy  String?

  /// Finding an ACTIVE session is the hot path — the admin UI asks on every
  /// page load so the banner cannot be missed.
  @@index([expiresAt, revokedAt])
  @@index([adminId, startedAt])
}


// ═══════════════════════════════════════════════════════════════════════════
// MIRRORED FROM THE MAIN APP — 15 August 2026
//
// Admin owns no migrations (INTEGRATION-CONTRACT B.3); these exist purely so
// the generated client knows the columns. They had drifted: the main app added
// them and step 3 of B.3 was missed.
//
// It is not cosmetic. The DSAR data export calls db.party.findMany and
// db.transaction.findMany with NO select, so Prisma returns only the columns
// THIS schema declares. Party.customFields and Transaction.customFields were
// missing, so a user asking for their own data was silently handed an export
// with their custom fields stripped out — no error, nothing to notice.
// ═══════════════════════════════════════════════════════════════════════════

// ==================== PAYMENT ALLOCATION (C5) ====================
// 🔒 AUDIT C5: links a Payment to the specific bill(s) it settles.
//
// THE DEFECT THIS FIXES: a "Settle" payment reduced the PARTY balance but no
// bill knew about it, so an invoice kept displaying its original amount as due
// forever. Party outstanding and the sum of bill dues disagreed permanently,
// from the first partial payment onward. Worse, the stale "Due" invited the
// shopkeeper to collect that amount again — and nothing would have stopped it,
// because settling a bill for exactly what it claims to owe looks correct.
//
// A bill's true due is now:
//     totalAmount − paidAmount − Σ(allocations)
//
// WHY A SEPARATE TABLE rather than a paidAmount bump on the Transaction:
// the allocation is a FACT about a specific payment settling a specific bill.
// Folding it into paidAmount would lose which payment did it, making a payment
// impossible to reverse cleanly and leaving disputes unanswerable ("you say I
// paid — against what?").
model PaymentAllocation {
  id            String   @id @default(cuid())
  userId        String // denormalised for tenant-scoped queries + indexes
  paymentId     String
  transactionId String
  amount        Int // paise, like every other money column
  createdAt     DateTime @default(now())

  // Deleting a payment removes its allocations: the money never arrived, so
  // the bills it was covering must go back to being due.
  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  // Transactions are SOFT-deleted, never hard-deleted, so no cascade here —
  // the allocation must survive to keep the audit trail answerable.
  transaction Transaction @relation(fields: [transactionId], references: [id])

  // One row per (payment, bill). Re-allocating updates rather than duplicating,
  // which also makes an offline replay idempotent.
  @@unique([paymentId, transactionId])
  // "What has been settled against this bill?" — the hot read behind every
  // due calculation.
  @@index([userId, transactionId])
  @@index([paymentId])
}

/**
 * A field the shop invented, and what it means.
 * 📄 Phase 5 of docs/INVOICE-ENGINE-PLAN.md.
 * THE DEFINITIONS LIVE HERE; THE VALUES DO NOT. Values are snapshotted into a
 * JSON column on the record they belong to — Party.customFields,
 * Transaction.customFields, TransactionItem.customCols. src/lib/custom-fields.ts
 * carries the full reasoning; the short version is that drawing one bill is the
 * hot path, and a values table would put a join on it for every render, thirty
 * million rows deep, to print a grocery bill.
 * WHY A CHEMIST NEEDS THIS. The Drugs and Cosmetics Act requires the batch
 * number and expiry date of every medicine sold to appear on the record, and
 * Drug Inspectors check billing against it. Without custom columns a pharmacy
 * cannot use this app for its actual job.
 * `key` is generated once from the label and NEVER changes: issued bills are
 * keyed on it. `label` may be renamed freely, because every bill already
 * carries the label it was printed with.
 */
model CustomFieldDef {
  id            String  @id @default(cuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// party | invoice | item
  entity        String
  /// Stable identifier, generated from the label at creation. Never changes.
  key           String
  /// What the shopkeeper reads. Renaming does not touch issued bills.
  label         String
  /// text | number | date | money
  type          String  @default("text")
  /// Print it on the bill, or keep it for the shop's own records only.
  showOnInvoice Boolean @default(true)
  required      Boolean @default(false)
  order         Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete: an issued bill still carries values for a retired field,
  /// and those must keep printing. Removing the definition only stops it
  /// being offered on NEW bills.
  deletedAt DateTime?

  /// One shop cannot define the same key twice on the same entity.
  @@unique([userId, entity, key])
  @@index([userId, entity, deletedAt])
}

/**
 * A shareable link to one bill.
 * 📄 Phase 4 of docs/DOCUMENT-ENGINE-PLAN.md. A long bill cannot be sent as a
 * readable picture and a PDF arrives as a grey card nobody opens, so the third
 * option is a link: any length, payable, always current, and it reports whether
 * the customer actually opened it.
 * ⚠️ THIS ROW IS A CAPABILITY. Anyone holding the token can read the bill —
 * there is no login, because the recipient is a customer who has no account.
 * The security is therefore entirely in the token, and the design pays for that
 * up front rather than retrofitting it:
 * - `token` is 32 random URL-safe characters from a CSPRNG, never a
 * sequential id and never derived from the transaction. Guessing one is
 * not a realistic attack; enumerating incrementing ids would have been.
 * - `expiresAt` and `revokedAt` mean a link is not forever. A shopkeeper who
 * shares one by mistake has a way back.
 * - The page is `noindex`, so a link pasted into a public group does not end
 * up in a search engine.
 * - Views are counted, which is the point for the shopkeeper chasing money —
 * but no IP or device data is stored with them. Knowing the bill was opened
 * is useful; building a profile of the customer who opened it is not ours
 * to do, and under the DPDP Act collecting it would need a purpose we do
 * not have.
 * ─────────────────────────────────────────────────────────────────────────
 * 🗑️ RETAINED, UNUSED as of 2026-08-15.
 * The shareable link was removed at Rahul's instruction: a link asking a
 * customer to pay reads as a scam to most people in India, however genuine
 * it is. /b/[token], /api/bill-share and lib/bill-share are deleted, and a
 * test asserts nothing queries this model.
 * THE TABLE AND ITS ROWS STAY. Links a shopkeeper already minted are their
 * own record, and this codebase does not delete a user's data to tidy up
 * after a withdrawn feature. Old links 404 because the page is gone, not
 * because anything was erased.
 */
model BillShare {
  id            String      @id @default(cuid())
  /// 32 URL-safe characters from crypto.randomBytes. Unique, unguessable.
  token         String      @unique
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  /// null = no expiry. The shop chooses.
  expiresAt DateTime?
  /// Set when the shop kills the link. Kept rather than deleted so the audit
  /// trail still shows a link existed and was withdrawn.
  revokedAt DateTime?

  /// Sent → viewed → paid is what a shopkeeper chasing money wants to know.
  viewCount     Int       @default(0)
  firstViewedAt DateTime?
  lastViewedAt  DateTime?

  @@index([userId, createdAt])
  @@index([transactionId])
}

/// What THIS shop calls this party — C2c.
///
/// The compounding half of the resolver. No amount of letter-comparing can
/// discover that "chhota Ramesh" means Ramesh Kumar; only the shop knows, and
/// only because they told us by tapping a choice. It is also the one part a
/// competitor cannot copy, because it is that shop's own history.
///
/// WRITTEN FROM A CONFIRMATION THEY WERE ALREADY MAKING — never from a
/// settings screen, which nobody fills in.
model PartyAlias {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  partyId String
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  /// Stored NORMALISED (lower-cased, honorifics and spelling variants folded)
  /// so the lookup is an exact match and cannot drift from resolve-name's
  /// comparison rules.
  alias String

  /// What they actually typed or said, kept only to show them on the party
  /// screen. "Chhota Ramesh" reads better than "chota ramesh".
  saidAs String

  createdAt DateTime @default(now())

  /// ONE ALIAS MEANS ONE PARTY, per shop. Without this, teaching the app twice
  /// would create the very ambiguity aliases exist to remove — and the second
  /// lesson would silently disagree with the first.
  @@unique([userId, alias])
  @@index([userId, partyId])
}
