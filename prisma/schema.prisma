model SupplierReport {
  id        String  @id @default(cuid())
  name      String
  type      String // product_trends | transaction_volume | payment_patterns | regional_insights | category_analysis
  partnerId String? // linked Partner (optional — null = general report)
  status    String  @default("generated") // generated | delivered | archived

  // Report content (JSON with aggregated data)
  summary    String? @db.Text // human-readable summary
  data       String  @default("{}") @db.Text // JSON: aggregated data
  dataPoints Int     @default(0) // number of data points in report
  userCount  Int     @default(0) // number of users included in aggregation

  // Pricing
  priceInr Float @default(0) // price charged to partner (₹)

  // Metadata
  period      String? // e.g. "2026-06" or "Q2 2026"
